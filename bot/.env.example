# Discord application
DISCORD_TOKEN=

# Shared secret with screenshare-app (stream.discord.notifyKey)
STREAMY_API_KEY=

# Local HTTP API for the desktop app.
PORT=8791

# Optional: fallback channel when the app omits channelId.
WATCH_CHANNEL_ID=

# Public viewer link the bot posts. The desktop app normally sends this in the
# notify payload; this is the fallback.
VIEWER_URL=https://streamy-viewer.pages.dev/
